local function applyTextWatcher()
    local textWatcherProxy = luajava.createProxy("android.text.TextWatcher", {
        beforeTextChanged = function(s, start, count, after) end,
        onTextChanged = function(s, start, before, count)
            if not isChatActive or currentRoom == "" then return end
            local len = s.toString():len()
            if len > 0 and not isTyping then
                isTyping = true
                executeHttp("PUT", base_url_rooms .. currentRoom .. "/typing/" .. android_id .. ".json", '"'..currentUsername..'"', function() end)
            elseif len == 0 and isTyping then
                isTyping = false
                executeHttp("DELETE", base_url_rooms .. currentRoom .. "/typing/" .. android_id .. ".json", nil, function() end)
            end
        end,
        afterTextChanged = function(s) end
    })
    ui.inputMessage.addTextChangedListener(textWatcherProxy)
end
