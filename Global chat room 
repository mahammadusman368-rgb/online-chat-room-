local privateItemKeys = {} local privateItemValues = {}

loadPrivateMessages = function()
    if not isPrivateChatActive then return end
    local chatRoomKey = getPrivateChatKey(android_id, currentChatPartnerID)
    executeHttp("GET", base_url_private .. chatRoomKey .. ".json", nil, function(code, res)
        if not isPrivateChatActive then return end local newValues = {} local tempKeys = {}
        if code == "200" and res ~= "null" and res ~= "" then pcall(function()
            local json = JSONObject(res) local keys = {} local iter = json.keys() while iter.hasNext() do table.insert(keys, iter.next()) end table.sort(keys)
            local now = os.time() local hasNew = false local latestSpeak = ""
            for i, k in ipairs(keys) do
                local obj = json.getJSONObject(k) local ts = obj.has("timestamp") and obj.getInt("timestamp") or 0
                if ts > 0 and (now - ts) > EXPIRY_SECONDS then executeHttp("DELETE", base_url_private .. chatRoomKey .. "/" .. k .. ".json", nil, function() end)
                elseif currentPrivateClearedKey == "" or k > currentPrivateClearedKey then
                    local sID = obj.getString("sender_id")
                    local isReadByOther = obj.has("read") and obj.getBoolean("read")
                    local statusTag
                    if sID == android_id then statusTag = isReadByOther and " [Read Message]" or " [Sent Message]"
                    else statusTag = " [Receive Message]" end
                    local textContent = obj.getString("text")
                    local sender = obj.getString("sender")
                    local disp = sender .. ": " .. textContent .. " (" .. obj.getString("time") .. ")" .. statusTag
                    table.insert(newValues, disp) table.insert(tempKeys, k)
                    
                    if sID ~= android_id and (not privateItemKeys[#privateItemKeys] or k > privateItemKeys[#privateItemKeys]) then 
                        hasNew = true latestSpeak = sender .. " ka message aaya hai: " .. textContent
                    end
                    if sID ~= android_id and not isReadByOther then
                        executeHttp("PUT", base_url_private .. chatRoomKey .. "/" .. k .. "/read.json", "true", function() end)
                    end
                end
            end
            if hasNew then playSound("receive") tts(latestSpeak) end
        end) end
        privateItemKeys = tempKeys privateItemValues = newValues ui.privateChatList.setAdapter(ArrayAdapter(service, android.R.layout.simple_list_item_1, String(privateItemValues)))
        if #privateItemValues > 0 then ui.privateChatList.setSelection(#privateItemValues - 1) end
        if isPrivateFirstLoad then tts("Loaded.") isPrivateFirstLoad = false end
    end)
end
startPrivateAutoRefresh = function() if not isPrivateChatActive then return end loadPrivateMessages() ui_handler.postDelayed(Runnable{run=startPrivateAutoRefresh}, 5000) end

