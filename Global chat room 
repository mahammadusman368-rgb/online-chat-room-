loadMessages = function()
    if not isChatActive or currentRoom == "" then return end
    executeHttp("GET", base_url_rooms .. currentRoom .. "/messages.json", nil, function(code, res)
        if not isChatActive then return end
        if code == "200" and res ~= "null" and res ~= "" then
            pcall(function()
                local json = JSONObject(res) local keys = {} local iter = json.keys()
                while iter.hasNext() do table.insert(keys, iter.next()) end table.sort(keys)
                
                local newValues = {} local tempKeys = {}
                local hasNewIncomingMsg = false local justScroll = false local latestSpeak = "" local validMsgCount = 0 
                local now = os.time() local isMentioned = false
                
                for i, k in ipairs(keys) do
                    local obj = json.getJSONObject(k) local ts = obj.has("timestamp") and obj.getInt("timestamp") or 0
                    local msgIsStarred = isStarred(k)
                    
                    if ts > 0 and (now - ts) > EXPIRY_SECONDS and not msgIsStarred then executeHttp("DELETE", base_url_rooms .. currentRoom .. "/messages/" .. k .. ".json", nil, function() end)
                    elseif msgIsStarred or lastClearedKey == "" or k > lastClearedKey then
                        validMsgCount = validMsgCount + 1
                        local senderID = obj.has("sender_id") and obj.getString("sender_id") or ""
                        local senderName = obj.getString("sender")
                        local text = obj.getString("text")
                        local rep = obj.has("replyTo") and obj.getString("replyTo") or ""
                        local tme = obj.has("time") and obj.getString("time") or ""
                        local hasAudio = obj.has("hasAudio") and obj.getBoolean("hasAudio") or false
                        local reaction = obj.has("reaction") and obj.getString("reaction") or ""
                        
                        rawMessages[k] = {sender_id=senderID, senderName=senderName, text=text, replyTo=rep, time=tme, hasAudio=hasAudio, reaction=reaction, key=k, isStarred=msgIsStarred}
                        local statusTag = senderID == android_id and " [Sent Message]" or " [Receive Message]"
                        local dispStr = (msgIsStarred and "Star " or "") .. senderName .. ": " .. (rep ~= "" and "[Replying " .. rep .. "] " or "") .. (hasAudio and "[Voice Message]" or text) .. (reaction ~= "" and " [" .. reaction .. "]" or "") .. " (" .. tme .. ")" .. statusTag
                        table.insert(newValues, dispStr) table.insert(tempKeys, k)
                        
                        if not knownKeys[k] then
                            knownKeys[k] = true
                            if senderID == android_id then justScroll = true else
                                hasNewIncomingMsg = true
                                if text:find("@" .. currentUsername) then isMentioned = true end
                                if text:find("Announcement") then latestSpeak = "Announcement aayi hai: " .. text elseif hasAudio then latestSpeak = senderName .. " ka voice message aaya hai." else latestSpeak = senderName .. " ka message aaya hai: " .. text end
                            end
                        end
                    else knownKeys[k] = true end
                end
                
                itemKeys = tempKeys itemValues = newValues
                ui.chatList.setAdapter(ArrayAdapter(service, android.R.layout.simple_list_item_1, String(itemValues)))
                
                if isFirstLoad then
                    if validMsgCount > 0 then tts("Loaded.") else tts("Loaded. No messages.") end isFirstLoad = false
                elseif hasNewIncomingMsg then
                    if isMentioned then playSound("mention") tts("Aapko mention kiya gaya! " .. latestSpeak)
                    else playSound("receive") tts(latestSpeak) end
                    ui.chatList.setSelection(#itemValues - 1)
                elseif justScroll then ui.chatList.setSelection(#itemValues - 1) end
            end)
        end
    end)
    
    executeHttp("GET", base_url_rooms .. currentRoom .. "/typing.json", nil, function(tc, tr)
        if tc == "200" and tr ~= "null" then pcall(function()
            local tj = JSONObject(tr) local tit = tj.keys() local typists = {}
            while tit.hasNext() do local tkey = tit.next() if tkey ~= android_id then table.insert(typists, tj.getString(tkey)) end end
            if #typists > 0 then ui.tvTypingStatus.setText(table.concat(typists, ", ") .. " typing...") ui.tvTypingStatus.setVisibility(View.VISIBLE)
            else ui.tvTypingStatus.setVisibility(View.GONE) end
        end) else ui.tvTypingStatus.setVisibility(View.GONE) end
    end)
    
    executeHttp("GET", db_url_online, nil, function(oc, or_)
        if oc == "200" and or_ ~= "null" then pcall(function()
            local oj = JSONObject(or_) local oit = oj.keys() local now = os.time() local count = 0
            while oit.hasNext() do
                local ok = oit.next() local uData = oj.getJSONObject(ok)
                if uData.has("time") and (now - uData.getInt("time") <= 30) and uData.has("room") and uData.getString("room") == currentRoom then count = count + 1 end
            end
            ui.tvRoomHeader.setText(currentRoom .. " - (" .. count .. " Online)")
        end) end
    end)
end

