fetchMyProfile = function(callback)
    checkIfBlocked(function(blocked)
        if blocked then tts("Aapko block kar diya gaya hai.") callback("blocked", nil) return end
        executeHttp("GET", base_url_profiles .. android_id .. ".json", nil, function(c, r)
            if c == "200" and r ~= "null" and r ~= "" then
                local j = JSONObject(r)
                local isPending = j.has("pendingDelete") and j.getBoolean("pendingDelete")
                if isPending then
                    local pts = j.has("pendingDeleteTimestamp") and j.getInt("pendingDeleteTimestamp") or 0
                    if os.time() - pts >= DELETE_WAIT_SECONDS then executeHttp("DELETE", base_url_profiles .. android_id .. ".json", nil, function() callback("not_found", nil) end)
                    else callback("pending_delete", j) end
                else 
                    local lastAct = j.has("lastActiveTime") and j.getInt("lastActiveTime") or 0
                    local nm = j.getString("name")
                    if nm == creatorName then isAdmin = true end
                    if not isAdmin and lastAct > 0 and (os.time() - lastAct > 604800) then
                        executeHttp("DELETE", base_url_profiles .. android_id .. ".json", nil, function() tts("Profile delete ho gayi.") callback("not_found", nil) end)
                    else currentUsername = nm currentMood = j.has("mood") and j.getString("mood") or "Available" currentProfileData = j callback("active", j) end
                end
            else callback("not_found", nil) end
        end)
    end)
end

